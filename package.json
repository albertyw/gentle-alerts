{
  "name": "gentle-alerts",
  "version": "1.3.5",
  "description": "Convert alerts into gentle notifications",
  "type": "module",
  "scripts": {
    "test": "pnpm run build && pnpm run eslint && pnpm run wdio",
    "eslint": "tsc --noEmit && eslint -c .eslint.config.js gentle-alerts test",
    "package": "pnpm run clean && pnpm run build && zip -r gentle-alerts.zip gentle-alerts",
    "clean": "rm -f gentle-alerts/gentle-alerts.min.js gentle-alerts/bootstrap.js gentle-alerts/options.js && rm -f gentle-alerts.zip && find | grep DS | xargs rm -f",
    "build": "webpack",
    "wdio": "wdio run ./wdio.conf.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/albertyw/gentle-alerts.git"
  },
  "author": "Albert Wang",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/albertyw/gentle-alerts/issues"
  },
  "homepage": "https://github.com/albertyw/gentle-alerts#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.2.3",
    "@types/chrome": "^0.2.9",
    "@types/jquery": "^4.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.4.1",
    "@types/sinon": "^22.0.0",
    "@wdio/browser-runner": "^9.27.2",
    "@wdio/cli": "^9.27.2",
    "@wdio/mocha-framework": "^9.27.2",
    "@wdio/spec-reporter": "^9.27.2",
    "chai": "^6.2.2",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "jquery": "^4.0.0",
    "sinon": "^22.0.0",
    "ts-loader": "^9.6.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3"
  },
  "engines": {
    "node": ">=18"
  }
}
